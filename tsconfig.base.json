{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ai-novel/shared-types": ["packages/shared-types/src"],
      "@ai-novel/prompt-spec": ["packages/prompt-spec/src"]
    }
  }
}
