generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CanonStatus {
  draft
  confirmed
  archived
}

enum ChapterStatus {
  draft
  generating
  reviewing
  done
  archived
}

enum ChapterVersionSource {
  user
  ai
  imported
}

enum GenerationTaskType {
  generateChapter
  continueChapter
  rewriteChapter
  polishChapter
  summarizeChapter
  extractFacts
}

enum GenerationTaskStatus {
  pending
  running
  succeeded
  failed
  canceled
}

enum GeneratedDraftStatus {
  pending
  applied
  discarded
  superseded
}

enum AttemptStatus {
  running
  succeeded
  failed
  canceled
}

enum FactType {
  plot
  character
  world
  relationship
  item
  location
  custom
}

enum LLMProviderType {
  magpie
  mock
}

enum WorldItemType {
  location
  organization
  rule
  history
  magic_system
  technology
  item
  character_note
  timeline_event
  species
  system
  culture
  concept
  social_system
  custom
}

model Project {
  id                String    @id @default(cuid())
  title             String
  subtitle          String?
  status            String    @default("planning")
  logline           String?
  summary           String?
  premise           String?
  coreIdea          String?
  mainPlot          String?
  intro             String?
  storySeed         String?
  worldview         String?
  eraBackground     String?
  targetLength      String?
  estimatedChapters Int?
  wordsPerChapter   Int?
  language          String    @default("zh-CN")
  writingStyle      String?
  tone              String?
  pov               String?
  protagonist       String?
  coverAssetId      String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  genres              ProjectGenre[]
  tags                ProjectTag[]
  volumes             Volume[]
  chapters            Chapter[]
  chapterPlans        ChapterPlan[]
  characters          Character[]
  characterStates     CharacterState[]
  characterIdentities CharacterIdentity[]
  worldItems          WorldItem[]
  facts               Fact[]
  relationships       Relationship[]
  promptTemplates     PromptTemplate[]
  contextSnapshots    ContextSnapshot[]
  generationTasks     GenerationTask[]
  llmProviders        LLMProvider[]
  knowledgeChunks     KnowledgeChunk[]
  worldRules          WorldRule[]
  locations           Location[]
  locationStates      LocationState[]
  locationRules       LocationRule[]
  locationFactions    LocationFaction[]
  factions            Faction[]
  factionStates       FactionState[]
  factionMemberships  FactionMembership[]
  factionRelations    FactionRelation[]
  factionRules        FactionRule[]
  species             Species[]
  speciesTraits       SpeciesTrait[]
  speciesAbilities    SpeciesAbility[]
  speciesRules        SpeciesRule[]
  storyItems          StoryItem[]
  storyItemStates     StoryItemState[]
  storyItemRules      StoryItemRule[]
  abilities           Ability[]
  abilityRules        AbilityRule[]
  scenes              Scene[]
  scenePlans          ScenePlan[]
  sceneVersions       SceneVersion[]
  sceneSummaries      SceneSummary[]
  sceneHandoffs       SceneHandoff[]
  chapterSummaries    ChapterSummary[]
  generatedDrafts     GeneratedDraft[]

  @@index([status])
  @@index([deletedAt])
}

model Genre {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  parentId    String?
  orderIndex  Int       @default(0)
  isEnabled   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   Genre?         @relation("GenreHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Genre[]        @relation("GenreHierarchy")
  projects ProjectGenre[]

  @@index([parentId, orderIndex])
  @@index([isEnabled, orderIndex])
}

model Tag {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  orderIndex  Int       @default(0)
  isEnabled   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  projects ProjectTag[]

  @@index([isEnabled, orderIndex])
}

model ProjectGenre {
  projectId String
  genreId   String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([projectId, genreId])
  @@index([genreId])
}

model ProjectTag {
  projectId String
  tagId     String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([projectId, tagId])
  @@index([tagId])
}

model Volume {
  id         String    @id @default(cuid())
  projectId  String
  title      String
  orderIndex Int       @default(0)
  summary    String?
  goal       String?
  status     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters     Chapter[]
  chapterPlans ChapterPlan[]

  @@index([projectId, orderIndex])
  @@index([deletedAt])
}

model Chapter {
  id               String        @id @default(cuid())
  projectId        String
  volumeId         String?
  title            String
  plannedTitle     String?
  goal             String?
  orderIndex       Int           @default(0)
  summary          String?
  status           ChapterStatus @default(draft)
  currentVersionId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  volume          Volume?          @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  versions        ChapterVersion[]
  plans           ChapterPlan[]
  summaries       ChapterSummary[]
  characterStates CharacterState[]
  generationTasks GenerationTask[]
  locationStates  LocationState[]
  factionStates   FactionState[]
  storyItemStates StoryItemState[]
  scenes          Scene[]
  scenePlans      ScenePlan[]
  sceneVersions   SceneVersion[]
  sceneSummaries  SceneSummary[]
  sceneHandoffs   SceneHandoff[]

  @@index([projectId, orderIndex])
  @@index([volumeId, orderIndex])
  @@index([deletedAt])
}

model ChapterVersion {
  id               String               @id @default(cuid())
  chapterId        String
  generationTaskId String?              @unique
  source           ChapterVersionSource @default(user)
  content          String
  changeSummary    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  generationTask GenerationTask?  @relation("GenerationResultVersion", fields: [generationTaskId], references: [id], onDelete: SetNull)
  summaries      ChapterSummary[]

  @@index([chapterId, createdAt])
}

model ChapterPlan {
  id          String      @id @default(cuid())
  projectId   String
  volumeId    String?
  chapterId   String?
  title       String?
  goal        String?
  outline     String?
  pov         String?
  constraints Json?
  orderIndex  Int         @default(0)
  status      String      @default("planned")
  canonStatus CanonStatus @default(draft)
  sourceType  String?
  sourceId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  volume     Volume?     @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  chapter    Chapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  scenePlans ScenePlan[]

  @@index([projectId, volumeId, orderIndex])
  @@index([projectId, orderIndex])
  @@index([projectId, chapterId])
  @@index([projectId, status])
  @@index([projectId, canonStatus])
  @@index([deletedAt])
}

model Scene {
  id                String      @id @default(cuid())
  projectId         String
  chapterId         String
  title             String?
  goal              String?
  orderIndex        Int         @default(0)
  status            String      @default("planned")
  storyTimeLabel    String?
  povCharacterId    String?
  primaryLocationId String?
  currentPlanId     String?
  currentVersionId  String?
  canonStatus       CanonStatus @default(draft)
  sourceType        String?
  sourceId          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  plans     ScenePlan[]
  versions  SceneVersion[]
  summaries SceneSummary[]
  handoffs  SceneHandoff[]

  @@index([projectId, chapterId, orderIndex])
  @@index([projectId, status, orderIndex])
  @@index([projectId, canonStatus])
  @@index([projectId, povCharacterId])
  @@index([projectId, primaryLocationId])
  @@index([deletedAt])
}

model ScenePlan {
  id            String      @id @default(cuid())
  projectId     String
  chapterId     String
  sceneId       String
  chapterPlanId String?
  title         String?
  goal          String?
  outline       String?
  conflict      String?
  choice        String?
  consequence   String?
  readerPromise String?
  readerPayoff  String?
  nextHook      String?
  constraints   Json?
  orderIndex    Int         @default(0)
  canonStatus   CanonStatus @default(draft)
  sourceType    String?
  sourceId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  scene       Scene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  chapterPlan ChapterPlan? @relation(fields: [chapterPlanId], references: [id], onDelete: SetNull)

  @@index([projectId, sceneId, orderIndex])
  @@index([projectId, chapterId, orderIndex])
  @@index([projectId, chapterPlanId])
  @@index([projectId, canonStatus])
  @@index([deletedAt])
}

model SceneVersion {
  id               String    @id @default(cuid())
  projectId        String
  chapterId        String
  sceneId          String
  source           String    @default("user")
  sourceType       String?
  sourceId         String?
  content          String
  wordCount        Int?
  changeSummary    String?
  basedOnVersionId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter         Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  scene           Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  basedOnVersion  SceneVersion?  @relation("SceneVersionHistory", fields: [basedOnVersionId], references: [id], onDelete: SetNull)
  derivedVersions SceneVersion[] @relation("SceneVersionHistory")
  summaries       SceneSummary[]
  handoffs        SceneHandoff[]

  @@index([projectId, sceneId, createdAt])
  @@index([projectId, chapterId, createdAt])
  @@index([projectId, source])
  @@index([basedOnVersionId])
  @@index([deletedAt])
}

model SceneSummary {
  id                String      @id @default(cuid())
  projectId         String
  chapterId         String
  sceneId           String
  sceneVersionId    String?
  summary           String
  keyEvents         Json?
  characterChanges  Json?
  locationChanges   Json?
  factionChanges    Json?
  worldRuleChanges  Json?
  newFacts          Json?
  readerVisibleInfo Json?
  canonStatus       CanonStatus @default(draft)
  createdBy         String?
  sourceType        String?
  sourceId          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  scene        Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneVersion SceneVersion? @relation(fields: [sceneVersionId], references: [id], onDelete: SetNull)

  @@index([projectId, sceneId, createdAt])
  @@index([projectId, chapterId, createdAt])
  @@index([projectId, canonStatus])
  @@index([sceneVersionId])
  @@index([deletedAt])
}

model SceneHandoff {
  id             String      @id @default(cuid())
  projectId      String
  chapterId      String
  sceneId        String
  sceneVersionId String?
  nextSceneId    String?
  readerKnows    Json?
  actualChanges  Json?
  openQuestions  Json?
  promisesOpened Json?
  promisesClosed Json?
  nextSceneMust  Json?
  riskNotes      Json?
  canonStatus    CanonStatus @default(draft)
  createdBy      String?
  sourceType     String?
  sourceId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  scene        Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneVersion SceneVersion? @relation(fields: [sceneVersionId], references: [id], onDelete: SetNull)

  @@index([projectId, sceneId, createdAt])
  @@index([projectId, chapterId, createdAt])
  @@index([projectId, nextSceneId])
  @@index([projectId, canonStatus])
  @@index([sceneVersionId])
  @@index([deletedAt])
}

model ChapterSummary {
  id               String      @id @default(cuid())
  projectId        String
  chapterId        String
  chapterVersionId String?
  summary          String
  keyEvents        Json?
  characterChanges Json?
  newFacts         Json?
  canonStatus      CanonStatus @default(draft)
  createdBy        String? // user | system
  sourceType       String?
  sourceId         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter        Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterVersion ChapterVersion? @relation(fields: [chapterVersionId], references: [id], onDelete: SetNull)

  @@index([projectId, chapterId, createdAt])
  @@index([projectId, canonStatus])
  @@index([chapterVersionId])
  @@index([deletedAt])
}

model Character {
  id              String      @id @default(cuid())
  projectId       String
  name            String
  kind            String?
  role            String?
  lifeStatus      String?
  personality     String?
  motivation      String?
  background      String?
  appearance      String?
  voiceStyle      String?
  relationshipMap Json?
  arc             String?
  importance      Int         @default(0)
  currentState    Json?
  canonStatus     CanonStatus @default(draft)
  sourceType      String?
  sourceId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  states             CharacterState[]
  identities         CharacterIdentity[]
  factionMemberships FactionMembership[]

  @@index([projectId, name])
  @@index([projectId, canonStatus])
  @@index([deletedAt])
}

model CharacterState {
  id                  String   @id @default(cuid())
  projectId           String
  characterId         String
  chapterId           String?
  stage               String?
  orderIndex          Int      @default(0)
  location            String?
  physicalState       String?
  emotionalState      String?
  goal                String?
  knownSecrets        Json?
  relationshipChanges Json?
  statusNote          String?
  sourceType          String? // user | ai | chapter_summary | fact
  sourceId            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  chapter   Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([projectId, characterId, createdAt])
  @@index([projectId, characterId, orderIndex])
  @@index([chapterId])
}

model CharacterIdentity {
  id          String      @id @default(cuid())
  projectId   String
  characterId String
  title       String
  description String?
  type        String?
  isPublic    Boolean     @default(false)
  startsAt    String?
  endsAt      String?
  importance  Int         @default(0)
  canonStatus CanonStatus @default(draft)
  sourceType  String?
  sourceId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId, characterId])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model WorldItem {
  id          String        @id @default(cuid())
  projectId   String
  type        WorldItemType @default(custom)
  name        String
  summary     String?
  content     String?
  tags        String[]      @default([])
  visibility  String?
  importance  Int           @default(0)
  canonStatus CanonStatus   @default(draft)
  sourceType  String?
  sourceId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@index([projectId, canonStatus])
  @@index([deletedAt])
}

model WorldRule {
  id                   String      @id @default(cuid())
  projectId            String
  title                String
  summary              String?
  content              String?
  ruleType             String?
  category             String?
  priority             String      @default("medium")
  status               String      @default("active")
  condition            String?
  effect               String?
  cost                 String?
  exception            String?
  violationConsequence String?
  isHardRule           Boolean     @default(false)
  isRevealed           Boolean     @default(false)
  visibility           String      @default("hidden")
  importance           Int         @default(0)
  canonStatus          CanonStatus @default(draft)
  sourceType           String?
  sourceId             String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locationRules  LocationRule[]
  factionRules   FactionRule[]
  speciesRules   SpeciesRule[]
  storyItemRules StoryItemRule[]
  abilityRules   AbilityRule[]

  @@index([projectId, ruleType])
  @@index([projectId, category])
  @@index([projectId, status])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model Location {
  id              String      @id @default(cuid())
  projectId       String
  parentId        String?
  name            String
  aliases         String[]    @default([])
  locationType    String?
  narrativeRole   String?
  summary         String?
  description     String?
  environment     String?
  atmosphere      String?
  terrain         String?
  climate         String?
  accessRule      String?
  dangerLevel     String?
  lifecycleStatus String?
  visibility      String?
  importance      Int         @default(0)
  canonStatus     CanonStatus @default(draft)
  orderIndex      Int         @default(0)
  sourceType      String?
  sourceId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Location?         @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[]        @relation("LocationHierarchy")
  states   LocationState[]
  rules    LocationRule[]
  factions LocationFaction[]

  @@index([projectId, name])
  @@index([projectId, parentId, orderIndex])
  @@index([projectId, locationType])
  @@index([projectId, lifecycleStatus])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model LocationState {
  id                 String   @id @default(cuid())
  projectId          String
  locationId         String
  chapterId          String?
  stage              String?
  orderIndex         Int      @default(0)
  lifecycleStatus    String?
  dangerLevel        String?
  accessRule         String?
  visibility         String?
  environmentChanges String?
  controlSummary     String?
  eventSummary       String?
  stateNote          String?
  sourceType         String?
  sourceId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  chapter  Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([projectId, locationId, createdAt])
  @@index([projectId, locationId, orderIndex])
  @@index([projectId, chapterId])
  @@index([chapterId])
}

model LocationRule {
  id               String   @id @default(cuid())
  projectId        String
  locationId       String
  worldRuleId      String
  relationType     String?
  isPrimary        Boolean  @default(false)
  enforcementLevel String?
  notes            String?
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  worldRule WorldRule @relation(fields: [worldRuleId], references: [id], onDelete: Cascade)

  @@index([projectId, locationId, orderIndex])
  @@index([projectId, worldRuleId])
  @@index([projectId, relationType])
}

model LocationFaction {
  id             String      @id @default(cuid())
  projectId      String
  locationId     String
  factionId      String
  relationType   String?
  influenceLevel String?
  isCurrent      Boolean     @default(true)
  startsAt       String?
  endsAt         String?
  notes          String?
  canonStatus    CanonStatus @default(draft)
  sourceType     String?
  sourceId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  faction  Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@index([projectId, locationId])
  @@index([projectId, factionId])
  @@index([projectId, relationType])
  @@index([projectId, isCurrent])
  @@index([projectId, canonStatus])
  @@index([deletedAt])
}

model Faction {
  id            String      @id @default(cuid())
  projectId     String
  parentId      String?
  name          String
  aliases       String[]    @default([])
  factionType   String?
  narrativeRole String?
  summary       String?
  description   String?
  ideology      String?
  goal          String?
  structure     String?
  resources     String?
  status        String?
  visibility    String?
  importance    Int         @default(0)
  canonStatus   CanonStatus @default(draft)
  orderIndex    Int         @default(0)
  sourceType    String?
  sourceId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          Faction?            @relation("FactionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Faction[]           @relation("FactionHierarchy")
  states          FactionState[]
  memberships     FactionMembership[]
  sourceRelations FactionRelation[]   @relation("FactionRelationSource")
  targetRelations FactionRelation[]   @relation("FactionRelationTarget")
  rules           FactionRule[]
  locations       LocationFaction[]

  @@index([projectId, name])
  @@index([projectId, parentId, orderIndex])
  @@index([projectId, factionType])
  @@index([projectId, status])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model FactionState {
  id               String   @id @default(cuid())
  projectId        String
  factionId        String
  chapterId        String?
  stage            String?
  orderIndex       Int      @default(0)
  status           String?
  powerLevel       String?
  influenceLevel   String?
  resourceState    String?
  internalState    String?
  publicReputation String?
  goal             String?
  conflictSummary  String?
  eventSummary     String?
  stateNote        String?
  sourceType       String?
  sourceId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  faction Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([projectId, factionId, createdAt])
  @@index([projectId, factionId, orderIndex])
  @@index([projectId, chapterId])
  @@index([chapterId])
}

model FactionMembership {
