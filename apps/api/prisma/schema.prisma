  @@index([projectId, name])
  @@index([projectId, abilityType])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model AbilityRule {
  id               String   @id @default(cuid())
  projectId        String
  abilityId        String
  worldRuleId      String
  relationType     String?
  isPrimary        Boolean  @default(false)
  enforcementLevel String?
  notes            String?
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ability   Ability   @relation(fields: [abilityId], references: [id], onDelete: Cascade)
  worldRule WorldRule @relation(fields: [worldRuleId], references: [id], onDelete: Cascade)

  @@index([projectId, abilityId, orderIndex])
  @@index([projectId, worldRuleId])
