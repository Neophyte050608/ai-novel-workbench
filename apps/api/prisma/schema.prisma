  visibility      String?
  condition       String?
  powerState      String?
  eventSummary    String?
  stateNote       String?
  sourceType      String?
  sourceId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyItem StoryItem @relation(fields: [storyItemId], references: [id], onDelete: Cascade)
  chapter   Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([projectId, storyItemId, createdAt])
  @@index([projectId, storyItemId, orderIndex])
  @@index([projectId, chapterId])
  @@index([chapterId])
}

model StoryItemRule {
  id               String   @id @default(cuid())
  projectId        String
  storyItemId      String
  worldRuleId      String
  relationType     String?
  isPrimary        Boolean  @default(false)
  enforcementLevel String?
  notes            String?
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyItem StoryItem @relation(fields: [storyItemId], references: [id], onDelete: Cascade)
  worldRule WorldRule @relation(fields: [worldRuleId], references: [id], onDelete: Cascade)

  @@index([projectId, storyItemId, orderIndex])
  @@index([projectId, worldRuleId])
  @@index([projectId, relationType])
}

model Ability {
  id             String      @id @default(cuid())
