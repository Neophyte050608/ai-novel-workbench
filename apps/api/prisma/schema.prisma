model StoryItem {
  id              String      @id @default(cuid())
  projectId       String
  parentId        String?
  name            String
  aliases         String[]    @default([])
  itemType        String?
  narrativeRole   String?
  summary         String?
  description     String?
  origin          String?
  appearance      String?
  function        String?
  effect          String?
  cost            String?
  limitation      String?
  owner           String?
  location        String?
  lifecycleStatus String?
  visibility      String?
  importance      Int         @default(0)
  canonStatus     CanonStatus @default(draft)
  orderIndex      Int         @default(0)
  sourceType      String?
  sourceId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   StoryItem?       @relation("StoryItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children StoryItem[]      @relation("StoryItemHierarchy")
  states   StoryItemState[]
  rules    StoryItemRule[]

  @@index([projectId, name])
  @@index([projectId, parentId, orderIndex])
  @@index([projectId, itemType])
  @@index([projectId, lifecycleStatus])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model StoryItemState {
