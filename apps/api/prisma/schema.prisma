model Fact {
  id          String      @id @default(cuid())
  projectId   String
  type        FactType    @default(custom)
  content     String
  entities    Json?
  sourceType  String?
  sourceId    String?
  confidence  Float?
  canonStatus CanonStatus @default(draft)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@index([projectId, canonStatus])
  @@index([deletedAt])
}

model Relationship {
  id           String      @id @default(cuid())
  projectId    String
  sourceType   String
  sourceId     String
  targetType   String
  targetId     String
  relationType String
  description  String?
  strength     Int?
  importance   Int         @default(0)
  isCurrent    Boolean     @default(true)
  startsAt     String?
  endsAt       String?
  direction    String?
  evidenceType String?
  evidenceId   String?
  canonStatus  CanonStatus @default(draft)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sourceType, sourceId])
  @@index([projectId, targetType, targetId])
  @@index([projectId, canonStatus])
  @@index([deletedAt])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  domain      String
  task        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions PromptVersion[]

  @@unique([projectId, name])
}

model PromptVersion {
  id               String   @id @default(cuid())
  promptTemplateId String
  version          String
  systemPrompt     String
  userPrompt       String
  variablesSchema  Json?
  outputSchema     Json?
  changeLog        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  promptTemplate  PromptTemplate   @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  generationTasks GenerationTask[]
  promptRenders   PromptRender[]

  @@unique([promptTemplateId, version])
}

model PromptRender {
  id               String   @id @default(cuid())
  generationTaskId String   @unique
  promptVersionId  String
  variables        Json
  renderedSystem   String
  renderedUser     String
  renderedHash     String?
  createdAt        DateTime @default(now())

  task          GenerationTask @relation(fields: [generationTaskId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion  @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)

  @@index([promptVersionId])
}

model ContextSnapshot {
  id             String   @id @default(cuid())
  projectId      String
  purpose        String
  targetType     String?
  targetId       String?
  chapterId      String?
  sceneId        String?
  builderVersion String?
  tokenEstimate  Int?
  metadata       Json?
  sourceRefs     Json?
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationTasks GenerationTask[]

  @@index([projectId, purpose, createdAt])
  @@index([projectId, targetType, targetId, createdAt])
  @@index([projectId, chapterId, createdAt])
  @@index([projectId, sceneId, createdAt])
}

model LLMProvider {
  id        String          @id @default(cuid())
  projectId String?
  name      String
  type      LLMProviderType
  baseUrl   String?
  model     String
  config    Json?
  secretRef String?
  isDefault Boolean         @default(false)
  isEnabled Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationTasks GenerationTask[]

  @@index([projectId, isEnabled])
  @@index([projectId, isDefault])
  @@index([deletedAt])
}

model GeneratedDraft {
  id                String               @id @default(cuid())
  projectId         String
  targetType        String
  targetId          String?
  draftType         String
  payload           Json
  textPreview       String?
  status            GeneratedDraftStatus @default(pending)
  sourceTaskId      String?
  feedback          String?
  previousDraftId   String?
  appliedTargetType String?
  appliedTargetId   String?
  appliedAt         DateTime?
  discardedAt       DateTime?
  supersededAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  previousDraft GeneratedDraft?  @relation("GeneratedDraftSupersession", fields: [previousDraftId], references: [id], onDelete: SetNull)
  nextDrafts    GeneratedDraft[] @relation("GeneratedDraftSupersession")

  @@index([projectId, status])
  @@index([projectId, targetType, targetId, status])
  @@index([sourceTaskId])
  @@index([previousDraftId])
  @@index([deletedAt])
}

model SecretCredential {
  id             String   @id @default(cuid())
  ref            String   @unique
  encryptedValue String
  iv             String
  authTag        String?
  algorithm      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GenerationTask {
  id                String               @id @default(cuid())
  projectId         String
  chapterId         String?
  type              GenerationTaskType
  status            GenerationTaskStatus @default(pending)
  input             Json?
  output            Json?
  error             Json?
  contextSnapshotId String?
  promptVersionId   String?
  providerId        String?
  resultVersionId   String?              @unique
  tokenUsage        Json?
  model             String?
  temperature       Float?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  startedAt         DateTime?
  finishedAt        DateTime?

  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter         Chapter?                @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  contextSnapshot ContextSnapshot?        @relation(fields: [contextSnapshotId], references: [id], onDelete: SetNull)
  promptVersion   PromptVersion?          @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  provider        LLMProvider?            @relation(fields: [providerId], references: [id], onDelete: SetNull)
  resultVersion   ChapterVersion?         @relation("GenerationResultVersion")
  promptRender    PromptRender?
  attempts        GenerationTaskAttempt[]
  events          GenerationEvent[]

  @@index([projectId, status, createdAt])
  @@index([providerId])
}

model GenerationTaskAttempt {
  id        String        @id @default(cuid())
  taskId    String
  attemptNo Int
  status    AttemptStatus
  error     Json?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime      @default(now())

  task GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, attemptNo])
  @@index([taskId, status])
}

model GenerationEvent {
  id        String   @id @default(cuid())
  taskId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  task GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model KnowledgeChunk {
  id         String      @id @default(cuid())
  projectId  String
  sourceType String
  sourceId   String
  content    String
  metadata   Json?
  status     CanonStatus @default(confirmed)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sourceType, sourceId])
  @@index([projectId, status])
}

