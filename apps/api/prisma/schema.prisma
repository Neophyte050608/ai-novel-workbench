  targetFaction Faction @relation("FactionRelationTarget", fields: [targetFactionId], references: [id], onDelete: Cascade)

  @@index([projectId, sourceFactionId])
  @@index([projectId, targetFactionId])
  @@index([projectId, relationType])
  @@index([projectId, isCurrent])
  @@index([projectId, canonStatus])
