  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  faction   Faction   @relation(fields: [factionId], references: [id], onDelete: Cascade)
  worldRule WorldRule @relation(fields: [worldRuleId], references: [id], onDelete: Cascade)

  @@index([projectId, factionId, orderIndex])
  @@index([projectId, worldRuleId])
  @@index([projectId, relationType])
}

model Species {
  id              String      @id @default(cuid())
  projectId       String
  parentId        String?
  name            String
  aliases         String[]    @default([])
  speciesType     String?
  narrativeRole   String?
  summary         String?
  description     String?
  appearance      String?
  lifespan        String?
  reproduction    String?
  socialStructure String?
  rarity          String?
  status          String?
  visibility      String?
  importance      Int         @default(0)
  canonStatus     CanonStatus @default(draft)
  orderIndex      Int         @default(0)
  sourceType      String?
  sourceId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Species?         @relation("SpeciesHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Species[]        @relation("SpeciesHierarchy")
  traits    SpeciesTrait[]
  abilities SpeciesAbility[]
  rules     SpeciesRule[]

  @@index([projectId, name])
  @@index([projectId, parentId, orderIndex])
  @@index([projectId, speciesType])
  @@index([projectId, status])
  @@index([projectId, rarity])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model SpeciesTrait {
  id            String      @id @default(cuid())
  projectId     String
  speciesId     String
  traitType     String?
  name          String
  summary       String?
  description   String?
  isInheritable Boolean     @default(false)
  isCommon      Boolean     @default(true)
  importance    Int         @default(0)
  canonStatus   CanonStatus @default(draft)
  sourceType    String?
  sourceId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@index([projectId, speciesId])
  @@index([projectId, traitType])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model SpeciesAbility {
  id                 String      @id @default(cuid())
  projectId          String
  speciesId          String
  name               String
  aliases            String[]    @default([])
  abilityType        String?
  summary            String?
  description        String?
  effect             String?
  cost               String?
  limitation         String?
  condition          String?
  inheritanceType    String?
  awakeningCondition String?
  masteryNotes       String?
  isCommon           Boolean     @default(true)
  isInheritable      Boolean     @default(false)
  isUnique           Boolean     @default(false)
  visibility         String?
  importance         Int         @default(0)
  canonStatus        CanonStatus @default(draft)
  sourceType         String?
  sourceId           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@index([projectId, speciesId])
  @@index([projectId, abilityType])
  @@index([projectId, inheritanceType])
  @@index([projectId, canonStatus])
  @@index([projectId, importance])
  @@index([deletedAt])
}

model SpeciesRule {
  id               String   @id @default(cuid())
  projectId        String
  speciesId        String
  worldRuleId      String
  relationType     String?
